# =============================================================================
# OGK-Server Environment Configuration (Copy to .env and replace secrets)
# =============================================================================

OGK_ENV=development
OGK_HOST=0.0.0.0
OGK_PORT=8443

# SQLite database path (WAL mode enabled automatically)
OGK_DATABASE_URL=sqlite:///./ogk_server.db

# 32-byte base64url-encoded master key for AES-GCM encryption at rest
# Generate with: python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
OGK_MASTER_KEY=REPLACE_WITH_32_BYTE_BASE64URL_KEY

# HMAC-SHA256 secret for signing policies (or per-device secrets derived/stored encrypted)
OGK_POLICY_HMAC_FALLBACK_KEY=REPLACE_WITH_RANDOM_HEX_SECRET

# TLS Certificates (generated by server/scripts/generate_certs.py)
OGK_TLS_CERT_PATH=server/certs/server.crt
OGK_TLS_KEY_PATH=server/certs/server.key
OGK_TLS_CA_PATH=server/certs/ca.crt

# Cookie & Session settings
OGK_COOKIE_SECURE=true
OGK_SESSION_TTL_HOURS=12

# Rate limiting
OGK_RATE_LIMIT_PER_MINUTE=120
OGK_LOGIN_RATE_LIMIT_PER_MINUTE=15

# Data retention (days)
OGK_DATA_RETENTION_DAYS=90
